# Rust
/target/
**/*.rs.bk

# Node / Next.js
node_modules/
apps/web/.next/
apps/web/out/
*.tsbuildinfo

# Environment — never commit secrets
.env
.env.*
!.env.example

# Data & workspaces created at runtime
/data/

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs
*.log
apps/web/.env.local

# Local-only notes (artifact index, scratch docs) — never committed
*.local.md
# `just demo` state. Ignoring the whole directory matters: a kept demo stack
# (FLUIDBOX_DEMO_KEEP=1, or answering "n" at the teardown prompt) leaves
# .demo/admin-token — a live admin credential for the running stack — on disk.
.demo/

# Generated by scripts/gate-proof.sh — evidence for one run, never committed
gate-proof-evidence/

# Terraform (deploy/cloud) — state stays local-then-S3, never in git
deploy/cloud/terraform/**/.terraform/
deploy/cloud/terraform/**/terraform.tfstate
deploy/cloud/terraform/**/terraform.tfstate.*
deploy/cloud/terraform/**/*.tfvars
!deploy/cloud/terraform/**/*.auto.tfvars.example
