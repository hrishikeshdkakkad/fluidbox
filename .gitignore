# Rust
/target/
**/*.rs.bk

# Node / Next.js
node_modules/
apps/web/.next/
apps/web/out/
*.tsbuildinfo

# Environment — never commit secrets
.env
.env.*
!.env.example

# Data & workspaces created at runtime
/data/

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs
*.log
apps/web/.env.local

# Local-only notes (artifact index, scratch docs) — never committed
*.local.md
# `just demo` state. Ignoring the whole directory matters: a kept demo stack
# (FLUIDBOX_DEMO_KEEP=1, or answering "n" at the teardown prompt) leaves
# .demo/admin-token — a live admin credential for the running stack — on disk.
.demo/
# The live queue-admission e2e phase's scratch stack (scripts/e2e-queue-live.sh).
.queue-live/

# Generated by scripts/gate-proof.sh — evidence for one run, never committed
gate-proof-evidence/

# Terraform — plans and state NEVER enter git. Both carry generated secrets (the
# Cloud SQL password, the admin token, the sealing keys) in plaintext: a plan
# file is a zip whose `tfstate` member is a full state snapshot. So the rule is
# broader than "tidiness": a committed plan or state is a committed credential.
#
# REPO-WIDE and by EXTENSION. An earlier version listed the literal name
# `tfplan` under deploy/cloud/ only, so `-out=platform.tfplan` slipped past it
# and three production plans were committed. scripts/check-no-terraform-artifacts.sh
# (CI + `just check`) is the backstop for `git add -f` and renamed plans.
*.tfplan
tfplan
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info
deploy/cloud/**/*.tfvars
deploy/cloud/**/plan.json
!deploy/cloud/**/*.auto.tfvars.example
!deploy/cloud/**/*.tfvars.example

# Vercel CLI local project link (created by `vercel pull` at the repo root,
# because the project rootDirectory is apps/web and the CLI must run from here)
.vercel/

# Playwright output - artifacts, never sources.
tests/browser/test-results/
tests/browser/playwright-report/
