# Rust
/target/
**/*.rs.bk

# Node / Next.js
node_modules/
apps/web/.next/
apps/web/out/
*.tsbuildinfo

# Environment — never commit secrets
.env
.env.*
!.env.example

# Data & workspaces created at runtime
/data/

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs
*.log
apps/web/.env.local

# Local-only notes (artifact index, scratch docs) — never committed
*.local.md
data-gate/
# `just demo` state. Ignoring the whole directory matters: a kept demo stack
# (FLUIDBOX_DEMO_KEEP=1, or answering "n" at the teardown prompt) leaves
# .demo/admin-token — a live admin credential for the running stack — on disk.
.demo/
