# Rust
/target/
**/*.rs.bk

# Node / Next.js
node_modules/
apps/web/.next/
apps/web/out/
*.tsbuildinfo

# Environment — never commit secrets
.env
.env.*
!.env.example

# Data & workspaces created at runtime
/data/

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs
*.log
apps/web/.env.local

# Local-only notes (artifact index, scratch docs) — never committed
*.local.md
# `just demo` state. Ignoring the whole directory matters: a kept demo stack
# (FLUIDBOX_DEMO_KEEP=1, or answering "n" at the teardown prompt) leaves
# .demo/admin-token — a live admin credential for the running stack — on disk.
.demo/
# The live queue-admission e2e phase's scratch stack (scripts/e2e-queue-live.sh).
.queue-live/

# Generated by scripts/gate-proof.sh — evidence for one run, never committed
gate-proof-evidence/

# Terraform — state NEVER enters git. It carries generated secrets (the Cloud
# SQL password, the admin token, the sealing keys), so the rule is broader than
# "tidiness": a committed .tfstate is a committed credential.
#
# Two trees, matched by a single pattern set rather than one block per cloud —
# adding deploy/cloud/<newcloud>/ must not silently fall outside the net the way
# deploy/cloud/gcp/ did when it was added beside deploy/cloud/terraform/.
deploy/cloud/**/.terraform/
deploy/cloud/**/.terraform.tfstate.lock.info
deploy/cloud/**/terraform.tfstate
deploy/cloud/**/terraform.tfstate.*
deploy/cloud/**/*.tfvars
deploy/cloud/**/tfplan
deploy/cloud/**/plan.json
!deploy/cloud/**/*.auto.tfvars.example
!deploy/cloud/**/*.tfvars.example

# Playwright MCP page-snapshot dumps (browser tooling cache)
.playwright-mcp/

# Vercel CLI local project link (created by `vercel pull` at the repo root,
# because the project rootDirectory is apps/web and the CLI must run from here)
.vercel/

# Playwright output - artifacts, never sources.
tests/browser/test-results/
tests/browser/playwright-report/
